<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_ecommerce_integration" model="ir.module.category">
        <field name="name">E-Commerce Integration</field>
        <field name="sequence">11</field>
        <field name="description">Access to eCommerce Instances, Stores, mappings, synchronization, and configuration.</field>
    </record>
    <record id="res_groups_privilege_ecommerce_integration" model="res.groups.privilege">
        <field name="name">E-Commerce Integration</field>
        <field name="sequence">10</field>
        <field name="category_id" ref="module_category_ecommerce_integration"/>
        <field name="placeholder" eval="''"/>
        <field name="description">Read-only User, synchronization Operator, or full Manager access.</field>
    </record>
    <record id="group_ecommerce_user" model="res.groups">
        <field name="name">User</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_ecommerce_integration"/>
        <field name="comment">Read-only access to eCommerce integration records.</field>
    </record>
    <record id="group_ecommerce_operator" model="res.groups">
        <field name="name">Operator</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_ecommerce_integration"/>
        <field name="implied_ids" eval="[(4, ref('group_ecommerce_user'))]"/>
        <field name="comment">Run synchronization and maintain mappings.</field>
    </record>
    <record id="group_ecommerce_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="sequence">30</field>
        <field name="privilege_id" ref="res_groups_privilege_ecommerce_integration"/>
        <field name="implied_ids" eval="[(4, ref('group_ecommerce_operator')), (4, ref('queue_job.group_queue_job_manager'))]"/>
        <field name="comment">Configure Instances, credentials, and schedules.</field>
    </record>

    <record id="rule_ecommerce_queue_job_operator" model="ir.rule">
        <field name="name">Queue Job: eCommerce Operator scope</field>
        <field name="model_id" ref="queue_job.model_queue_job"/>
        <field name="domain_force">[('channel', '=like', 'ecommerce%'), ('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_ecommerce_operator'))]"/>
    </record>
    <record id="rule_ecommerce_queue_job_manager" model="ir.rule">
        <field name="name">Queue Job: eCommerce Manager scope</field>
        <field name="model_id" ref="queue_job.model_queue_job"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_ecommerce_manager'))]"/>
    </record>

    <record id="rule_company_ecommerce_backend" model="ir.rule">
        <field name="name">ecommerce.backend: multi-company</field>
        <field name="model_id" ref="model_ecommerce_backend"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_ecommerce_user'))]"/>
    </record>

