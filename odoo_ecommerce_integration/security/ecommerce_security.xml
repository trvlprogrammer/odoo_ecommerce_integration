<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_ecommerce_user" model="res.groups">
        <field name="name">eCommerce User</field>
        <field name="comment">Read-only access to eCommerce integration records.</field>
    </record>
    <record id="group_ecommerce_operator" model="res.groups">
        <field name="name">eCommerce Operator</field>
        <field name="implied_ids" eval="[(4, ref('group_ecommerce_user'))]"/>
        <field name="comment">Run synchronization and maintain mappings.</field>
    </record>
    <record id="group_ecommerce_manager" model="res.groups">
        <field name="name">eCommerce Manager</field>
        <field name="implied_ids" eval="[(4, ref('group_ecommerce_operator'))]"/>
        <field name="comment">Configure backends, credentials, and schedules.</field>
    </record>

    <record id="rule_company_ecommerce_backend" model="ir.rule">
        <field name="name">ecommerce.backend: multi-company</field>
        <field name="model_id" ref="model_ecommerce_backend"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_ecommerce_user'))]"/>
    </record>

