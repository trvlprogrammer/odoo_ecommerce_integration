<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_product_template_form_inherit_ecommerce" model="ir.ui.view">
        <field name="name">product.template.form.inherit.ecommerce</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="before">
                <header>
                    <button name="action_open_ecommerce_sync_wizard" type="object" string="Sync to eCommerce" groups="odoo_ecommerce_integration.group_ecommerce_operator"/>
                </header>
            </xpath>
        </field>
    </record>
</odoo>
