<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ecommerce_product_sync_wizard_form" model="ir.ui.view">
        <field name="name">ecommerce.product.sync.wizard.form</field>
        <field name="model">ecommerce.product.sync.wizard</field>
        <field name="arch" type="xml">
            <form string="Sync to eCommerce">
                <group>
                    <group>
                        <field name="provider"/>
                        <field name="backend_id" options="{'no_create': True}"/>
                        <field name="operation"/>
                    </group>
                    <group>
                        <field name="store_ids" widget="many2many_tags" options="{'no_create': True}"/>
                        <field name="product_ids" widget="many2many_tags" options="{'no_create': True}"/>
                    </group>
                </group>
                <field name="existing_status" readonly="1"/>
                <footer>
                    <button name="action_sync" type="object" string="true" class="btn-primary">Queue Synchronization</button>
                    <button special="cancel" string="true">Cancel</button>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_ecommerce_product_sync_wizard" model="ir.actions.act_window">
        <field name="name">Sync to eCommerce</field>
        <field name="res_model">ecommerce.product.sync.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
