<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ecommerce_store_list" model="ir.ui.view">
        <field name="name">ecommerce.store.list</field>
        <field name="model">ecommerce.store</field>
        <field name="arch" type="xml">
            <list string="Stores">
                <field name="name"/>
                <field name="code"/>
                <field name="backend_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="external_store_view_code"/>
                <field name="warehouse_id"/>
                <field name="last_preflight_error"/>
            </list>
        </field>
    </record>

    <record id="view_ecommerce_store_form" model="ir.ui.view">
        <field name="name">ecommerce.store.form</field>
        <field name="model">ecommerce.store</field>
        <field name="arch" type="xml">
            <form string="Store">
                <header>
                    <field name="can_preflight" invisible="1"/>
                    <field name="can_sync" invisible="1"/>
                    <button name="action_preflight" type="object" string="Test / Preflight"
                            invisible="not can_preflight"/>
                    <button name="action_open_ecommerce_sync_wizard" type="object"
                            string="Sync Now" class="btn-primary"
                            groups="odoo_ecommerce_integration.group_ecommerce_operator"
                            invisible="not can_sync"/>
                    <button name="action_view_jobs" type="object" string="View Jobs"
                            groups="odoo_ecommerce_integration.group_ecommerce_operator"/>
                </header>
                <sheet>
                    <div class="alert alert-success" role="status"
                         invisible="not last_preflight_at or last_preflight_error">
                        <strong>Preflight passed.</strong>
                        The backend, store-view scope, warehouse, and inventory source are configured.
                    </div>
                    <div class="alert alert-danger" role="alert" invisible="not last_preflight_error">
                        <strong>Preflight failed.</strong>
                        <field name="last_preflight_error" readonly="1" nolabel="1"/>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Store name"/></h1>
                    </div>
                    <notebook>
                        <page string="General" name="general">
                            <group>
                                <group>
                                    <field name="code"/>
                                    <field name="backend_id"/>
                                    <field name="company_id" groups="base.group_multi_company"/>
                                    <field name="active"/>
                                    <field name="external_website_id"/>
                                    <field name="external_website_code"/>
                                    <field name="external_store_view_id"/>
                                    <field name="external_store_view_code"/>
                                </group>
                                <group>
                                    <field name="warehouse_id"/>
                                    <field name="stock_location_id"/>
                                    <field name="pricelist_id"/>
                                    <field name="currency_id"/>
                                    <field name="default_sales_tax_id"/>
                                    <field name="default_international_tax_id"/>
                                    <field name="website_id" options="{'no_create': True}"/>
                                    <field name="shipping_product_id"/>
                                </group>
                            </group>
                        </page>
                        <page string="Catalog" name="catalog">
                            <group>
                                <group>
                                    <field name="product_batch_size"/>
                                    <field name="category_batch_size"/>
                                    <field name="customer_batch_size"/>
                                </group>
                                <group>
                                    <field name="stock_batch_size"/>
                                </group>
                            </group>
                        </page>
                        <page string="Orders &amp; Finance" name="orders_finance">
                            <group>
                                <group>
                                    <field name="auto_confirm_orders"/>
                                    <field name="auto_post_invoice"/>
                                    <field name="auto_register_payment"/>
                                    <field name="auto_register_refund"/>
                                    <field name="rounding_tolerance"/>
                                    <field name="order_import_cutoff_date"/>
                                </group>
                                <group>
                                    <field name="default_delivery_carrier_id" options="{'no_create': True}"/>
                                    <field name="default_payment_journal_id" options="{'no_create': True}"/>
                                </group>
                            </group>
                        </page>
                        <page string="Inventory &amp; Fulfillment" name="inventory_fulfillment">
                            <group>
                                <group>
                                    <field name="inventory_use_on_hand"/>
                                    <field name="inventory_subtract_reserved"/>
                                    <field name="inventory_safety_stock"/>
                                </group>
                                <group>
                                    <field name="shipment_batch_size"/>
                                </group>
                            </group>
                        </page>
                        <page string="Scheduling" name="scheduling">
                            <group>
                                <group>
                                    <field name="order_sync_interval_minutes"/>
                                    <field name="customer_sync_interval_minutes"/>
                                    <field name="catalog_sync_interval_minutes"/>
                                </group>
                                <group>
                                    <field name="category_sync_interval_minutes"/>
                                    <field name="inventory_sync_interval_minutes"/>
                                    <field name="shipment_sync_interval_minutes"/>
                                    <field name="finance_sync_interval_minutes"/>
                                </group>
                            </group>
                        </page>
                        <page string="Diagnostics" name="diagnostics">
                            <group>
                                <group>
                                    <field name="last_preflight_at"/>
                                    <field name="last_preflight_error"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_ecommerce_store_search" model="ir.ui.view">
        <field name="name">ecommerce.store.search</field>
        <field name="model">ecommerce.store</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <field name="backend_id"/>
                <filter name="active" string="Active" domain="[('active','=',True)]"/>
                <separator/>
                <filter name="backend" string="Backend" context="{'group_by':'backend_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_ecommerce_store" model="ir.actions.act_window">
        <field name="name">Stores</field>
        <field name="res_model">ecommerce.store</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
