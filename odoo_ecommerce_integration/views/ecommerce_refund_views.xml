<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_inherit_ecommerce_refund" model="ir.ui.view">
        <field name="name">account.move.form.inherit.ecommerce.refund</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <field name="ecommerce_refund" invisible="1"/>
            </xpath>
            <xpath expr="//header/button[@name='action_register_payment']" position="after">
                <button name="action_send_to_ecommerce"
                        type="object"
                        string="Send to eCommerce"
                        class="btn-secondary"
                        groups="odoo_ecommerce_integration.group_ecommerce_operator"
                        invisible="move_type != 'out_refund' or state != 'posted' or ecommerce_refund"/>
            </xpath>
        </field>
    </record>

    <record id="view_ecommerce_refund_export_wizard_form" model="ir.ui.view">
        <field name="name">ecommerce.refund.export.wizard.form</field>
        <field name="model">ecommerce.refund.export.wizard</field>
        <field name="arch" type="xml">
            <form string="Send Credit Note to eCommerce">
                <group>
                    <group>
                        <field name="move_id"/>
                        <field name="company_id" invisible="1"/>
                        <field name="currency_id" invisible="1"/>
                        <field name="refundable_amount"/>
                    </group>
                    <group>
                        <field name="store_id" options="{'no_create': True}"/>
                    </group>
                </group>
                <footer>
                    <button name="action_process" type="object" string="Process" class="btn-primary"/>
                    <button special="cancel" string="Cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_ecommerce_refund_export_wizard" model="ir.actions.act_window">
        <field name="name">Send Credit Note to eCommerce</field>
        <field name="res_model">ecommerce.refund.export.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
