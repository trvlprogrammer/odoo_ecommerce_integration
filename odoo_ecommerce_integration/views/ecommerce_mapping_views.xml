            </tree>
        </field>
    </record>
    <record id="view_ecommerce_refund_mapping_list" model="ir.ui.view">
        <field name="name">ecommerce.refund.mapping.list</field>
        <field name="model">ecommerce.refund.mapping</field>
        <field name="arch" type="xml">
            <tree string="Refund Mappings" create="false" edit="false">
                <field name="store_id"/>
                <field name="external_id"/>
                <field name="external_increment_id"/>
                <field name="order_mapping_id"/>
                <field name="amount"/>
                <field name="currency_id"/>
                <field name="status"/>
                <field name="odoo_credit_note_id"/>
            </tree>
        </field>
    </record>
    <record id="action_ecommerce_inventory_source_mapping" model="ir.actions.act_window">
        <field name="name">Inventory Sources</field>
        <field name="res_model">ecommerce.inventory.source.mapping</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_ecommerce_payment_method_mapping" model="ir.actions.act_window">
        <field name="name">Payment Methods</field>
        <field name="res_model">ecommerce.payment.method.mapping</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_ecommerce_carrier_mapping" model="ir.actions.act_window">
        <field name="name">Carriers</field>
        <field name="res_model">ecommerce.carrier.mapping</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_ecommerce_invoice_mapping" model="ir.actions.act_window">
        <field name="name">Invoice Mappings</field>
        <field name="res_model">ecommerce.invoice.mapping</field>
        <field name="view_mode">list</field>
    </record>
    <record id="action_ecommerce_payment_mapping" model="ir.actions.act_window">
        <field name="name">Payment Mappings</field>
        <field name="res_model">ecommerce.payment.mapping</field>
        <field name="view_mode">list</field>
    </record>
    <record id="action_ecommerce_shipment_mapping" model="ir.actions.act_window">
        <field name="name">Shipment Mappings</field>
        <field name="res_model">ecommerce.shipment.mapping</field>
        <field name="view_mode">list</field>
    </record>
    <record id="action_ecommerce_refund_mapping" model="ir.actions.act_window">
        <field name="name">Refund Mappings</field>
        <field name="res_model">ecommerce.refund.mapping</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
