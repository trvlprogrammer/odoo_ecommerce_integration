<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ecommerce_product_mapping_list" model="ir.ui.view">
        <field name="name">ecommerce.product.mapping.list</field>
        <field name="model">ecommerce.product.mapping</field>
        <field name="arch" type="xml">
            <tree string="Product Mappings">
                <field name="store_id"/>
                <field name="external_id"/>
                <field name="external_sku"/>
                <field name="odoo_template_id"/>
                <field name="external_product_type"/>
                <field name="sync_state"/>
                <field name="last_synced_at"/>
            </tree>
        </field>
    </record>

    <record id="view_ecommerce_variant_mapping_list" model="ir.ui.view">
        <field name="name">ecommerce.variant.mapping.list</field>
        <field name="model">ecommerce.variant.mapping</field>
        <field name="arch" type="xml">
            <tree string="Variant Mappings">
                <field name="store_id"/>
                <field name="external_id"/>
                <field name="external_sku"/>
                <field name="odoo_product_id"/>
                <field name="last_pushed_quantity"/>
                <field name="sync_state"/>
            </tree>
        </field>
    </record>

    <record id="view_ecommerce_category_mapping_list" model="ir.ui.view">
        <field name="name">ecommerce.category.mapping.list</field>
        <field name="model">ecommerce.category.mapping</field>
        <field name="arch" type="xml">
            <tree string="Category Mappings">
                <field name="store_id"/>
                <field name="external_id"/>
                <field name="external_parent_id"/>
                <field name="odoo_category_id"/>
                <field name="sync_state"/>
            </tree>
        </field>
    </record>


    <record id="view_ecommerce_category_mapping_form" model="ir.ui.view">
        <field name="name">ecommerce.category.mapping.form</field>
        <field name="model">ecommerce.category.mapping</field>
        <field name="arch" type="xml">
            <form string="eCommerce Category Mapping">
                <sheet>
                    <group>
                        <group>
                            <field name="backend_id"/>
                            <field name="store_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="external_id"/>
                            <field name="external_name"/>
                            <field name="external_parent_id"/>
                            <field name="external_level"/>
                        </group>
                        <group>
                            <field name="odoo_category_id"/>
                            <field name="sync_state"/>
                            <field name="last_synced_at"/>
                            <field name="last_error"/>
                            <field name="active"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_ecommerce_customer_mapping_list" model="ir.ui.view">
        <field name="name">ecommerce.customer.mapping.list</field>
        <field name="model">ecommerce.customer.mapping</field>
        <field name="arch" type="xml">
            <tree string="Customer Mappings">
                <field name="store_id"/>
                <field name="external_id"/>
                <field name="external_website_id"/>
                <field name="odoo_partner_id"/>
                <field name="sync_state"/>
            </tree>
        </field>
    </record>

    <record id="view_ecommerce_order_mapping_list" model="ir.ui.view">
        <field name="name">ecommerce.order.mapping.list</field>
        <field name="model">ecommerce.order.mapping</field>
        <field name="arch" type="xml">
            <tree string="Order Mappings">
                <field name="store_id"/>
                <field name="external_id"/>
                <field name="external_order_reference"/>
                <field name="odoo_sale_order_id"/>
                <field name="import_status"/>
                <field name="confirmation_status"/>
                <field name="financial_check"/>
                <field name="imported_at"/>
            </tree>
        </field>
    </record>

    <record id="view_ecommerce_order_mapping_form" model="ir.ui.view">
        <field name="name">ecommerce.order.mapping.form</field>
        <field name="model">ecommerce.order.mapping</field>
        <field name="arch" type="xml">
            <form string="Order Mapping">
                <sheet>
                    <group>
                        <group>
                            <field name="store_id"/>
                            <field name="external_id"/>
                            <field name="external_order_reference"/>
                            <field name="external_state"/>
                            <field name="external_status"/>
                            <field name="is_guest"/>
                        </group>
                        <group>
                            <field name="odoo_sale_order_id"/>
                            <field name="odoo_partner_id"/>
                            <field name="currency_id"/>
                            <field name="external_grand_total"/>
                            <field name="odoo_amount_total"/>
                            <field name="financial_check"/>
                        </group>
                    </group>
                    <group>
                        <field name="import_status"/>
                        <field name="confirmation_status"/>
                        <field name="last_error"/>
                        <field name="imported_at"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_ecommerce_product_mapping" model="ir.actions.act_window">
        <field name="name">Product Mappings</field>
        <field name="res_model">ecommerce.product.mapping</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_ecommerce_variant_mapping" model="ir.actions.act_window">
        <field name="name">Variant Mappings</field>
        <field name="res_model">ecommerce.variant.mapping</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_ecommerce_category_mapping" model="ir.actions.act_window">
        <field name="name">Category Mappings</field>
        <field name="res_model">ecommerce.category.mapping</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_ecommerce_customer_mapping" model="ir.actions.act_window">
        <field name="name">Customer Mappings</field>
        <field name="res_model">ecommerce.customer.mapping</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_ecommerce_order_mapping" model="ir.actions.act_window">
        <field name="name">Order Mappings</field>
        <field name="res_model">ecommerce.order.mapping</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_ecommerce_inventory_source_mapping_list" model="ir.ui.view">
        <field name="name">ecommerce.inventory.source.mapping.list</field>
        <field name="model">ecommerce.inventory.source.mapping</field>
        <field name="arch" type="xml">
            <tree string="Inventory Sources">
                <field name="store_id"/>
                <field name="external_id"/>
                <field name="external_source_name"/>
                <field name="warehouse_id"/>
                <field name="stock_location_id"/>
                <field name="active"/>
            </tree>
        </field>
    </record>
    <record id="view_ecommerce_inventory_source_mapping_form" model="ir.ui.view">
        <field name="name">ecommerce.inventory.source.mapping.form</field>
        <field name="model">ecommerce.inventory.source.mapping</field>
        <field name="arch" type="xml">
            <form string="Inventory Source Mapping">
                <sheet>
                    <group>
                        <group>
                            <field name="store_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="external_id" placeholder="default"/>
                            <field name="external_source_name" placeholder="Default Source"/>
                        </group>
                        <group>
                            <field name="warehouse_id"/>
                            <field name="stock_location_id"/>
                            <field name="active"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_ecommerce_payment_method_mapping_list" model="ir.ui.view">
        <field name="name">ecommerce.payment.method.mapping.list</field>
        <field name="model">ecommerce.payment.method.mapping</field>
        <field name="arch" type="xml">
            <tree string="Payment Methods">
                <field name="store_id"/>
                <field name="external_id"/>
                <field name="external_label"/>
                <field name="journal_id"/>
                <field name="active"/>
                <field name="sync_state"/>
            </tree>
        </field>
    </record>
    <record id="view_ecommerce_payment_method_mapping_form" model="ir.ui.view">
        <field name="name">ecommerce.payment.method.mapping.form</field>
        <field name="model">ecommerce.payment.method.mapping</field>
        <field name="arch" type="xml">
            <form string="Payment Method Mapping">
                <sheet>
                    <group>
                        <group>
                            <field name="backend_id"/>
                            <field name="store_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="external_id"/>
                            <field name="external_code"/>
                            <field name="external_label"/>
                        </group>
                        <group>
                            <field name="journal_id"/>
                            <field name="active"/>
                            <field name="sync_state"/>
                            <field name="last_synced_at"/>
                            <field name="last_error"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_ecommerce_carrier_mapping_list" model="ir.ui.view">
        <field name="name">ecommerce.carrier.mapping.list</field>
        <field name="model">ecommerce.carrier.mapping</field>
        <field name="arch" type="xml">
            <tree string="Carriers">
                <field name="store_id"/>
                <field name="external_id"/>
                <field name="external_label"/>
                <field name="delivery_carrier_id"/>
                <field name="active"/>
                <field name="sync_state"/>
            </tree>
        </field>
    </record>
    <record id="view_ecommerce_carrier_mapping_form" model="ir.ui.view">
        <field name="name">ecommerce.carrier.mapping.form</field>
        <field name="model">ecommerce.carrier.mapping</field>
        <field name="arch" type="xml">
            <form string="Carrier Mapping">
                <sheet>
                    <group>
                        <group>
                            <field name="backend_id"/>
                            <field name="store_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="external_id"/>
                            <field name="external_code"/>
                            <field name="external_label"/>
                        </group>
                        <group>
                            <field name="delivery_carrier_id"/>
                            <field name="active"/>
                            <field name="sync_state"/>
                            <field name="last_synced_at"/>
                            <field name="last_error"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_ecommerce_invoice_mapping_list" model="ir.ui.view">
        <field name="name">ecommerce.invoice.mapping.list</field>
        <field name="model">ecommerce.invoice.mapping</field>
        <field name="arch" type="xml">
            <tree string="Invoice Mappings" create="false" edit="false">
                <field name="store_id"/>
                <field name="external_id"/>
                <field name="external_increment_id"/>
                <field name="order_mapping_id"/>
                <field name="odoo_move_id"/>
                <field name="status"/>
                <field name="posted_at"/>
            </tree>
        </field>
    </record>
    <record id="view_ecommerce_payment_mapping_list" model="ir.ui.view">
        <field name="name">ecommerce.payment.mapping.list</field>
        <field name="model">ecommerce.payment.mapping</field>
        <field name="arch" type="xml">
            <tree string="Payment Mappings" create="false" edit="false">
                <field name="store_id"/>
                <field name="external_id"/>
                <field name="order_mapping_id"/>
                <field name="amount"/>
                <field name="currency_id"/>
                <field name="status"/>
                <field name="odoo_payment_id"/>
            </tree>
        </field>
    </record>
    <record id="view_ecommerce_shipment_mapping_list" model="ir.ui.view">
        <field name="name">ecommerce.shipment.mapping.list</field>
