<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ecommerce_store_sync_wizard_form" model="ir.ui.view">
        <field name="name">ecommerce.store.sync.wizard.form</field>
        <field name="model">ecommerce.store.sync.wizard</field>
        <field name="arch" type="xml">
            <form string="Run eCommerce Synchronization">
                <group>
                    <group>
                        <field name="operation"/>
                        <field name="data_type"/>
                        <field name="provider"/>
                        <field name="backend_id"/>
                    </group>
                    <group>
                        <field name="store_ids" widget="many2many_tags"/>
                        <field name="capability_summary" nolabel="1"/>
                        <field name="can_queue" invisible="1"/>
                    </group>
                </group>
                <div class="alert alert-warning" invisible="can_queue">
                    The selected operation is not supported by every selected Store.
                    Choose a supported operation/data type or adjust the Store selection.
                </div>
                <footer>
                    <button name="action_sync" type="object" string="Queue Synchronization"
                            class="btn-primary" invisible="not can_queue"/>
                    <button special="cancel" string="Cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_ecommerce_store_sync_wizard" model="ir.actions.act_window">
        <field name="name">Run eCommerce Synchronization</field>
        <field name="res_model">ecommerce.store.sync.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
