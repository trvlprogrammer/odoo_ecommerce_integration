<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="ecommerce_dashboard.Dashboard">
        <div class="o_ecommerce_dashboard">
            <header class="o_ecommerce_dashboard_header">
                <div class="o_ecommerce_dashboard_heading">
                    <span class="o_ecommerce_dashboard_eyebrow">Commerce overview</span>
                    <h1>eCommerce Dashboard</h1>
                    <p>
                        Odoo totals compared with each configured Store for the active company
                        <t t-if="state.meta.active_companies and state.meta.active_companies.length">
                            (<t t-esc="state.meta.active_companies.map((c) => c.name).join(', ')"/>)
                        </t>.
                    </p>
                </div>
                <div class="o_ecommerce_dashboard_filters">
                    <label>Provider
                        <select t-on-change="onProviderChange" class="form-select">
                            <option value="">All providers</option>
                            <t t-foreach="state.meta.providers" t-as="provider" t-key="provider.code">
                                <option t-att-value="provider.code" t-att-selected="state.filters.provider === provider.code">
                                    <t t-esc="provider.label"/>
                                </option>
                            </t>
                        </select>
                    </label>
                    <label>Backend
                        <select t-on-change="onBackendChange" class="form-select">
                            <option value="">All backends</option>
                            <t t-foreach="filteredBackends()" t-as="backend" t-key="backend.id">
                                <option t-att-value="backend.id" t-att-selected="state.filters.backend_id === backend.id">
                                    <t t-esc="backend.name"/>
                                </option>
                            </t>
                        </select>
                    </label>
                    <label>Store
                        <select t-on-change="onStoreChange" class="form-select">
                            <option value="">All Stores</option>
                            <t t-foreach="filteredStores()" t-as="store" t-key="store.id">
                                <option t-att-value="store.id" t-att-selected="state.filters.store_id === store.id">
                                    <t t-esc="store.name"/>
                                </option>
                            </t>
                        </select>
                    </label>
                    <label>From
                        <input type="date" class="form-control" t-model="state.filters.date_from" t-on-change="onDateChange"/>
                    </label>
                    <label>To
                        <input type="date" class="form-control" t-model="state.filters.date_to" t-on-change="onDateChange"/>
                    </label>
                    <div class="o_ecommerce_dashboard_filter_actions">
                        <button type="button" class="btn btn-secondary" t-on-click="resetFilters">Reset</button>
                        <button type="button" class="btn btn-link" t-on-click="load">
                            <i class="fa fa-refresh"/> Refresh
                        </button>
                    </div>
                </div>
            </header>

            <div t-if="state.error" class="o_ecommerce_dashboard_error" role="alert">
                <div>
                    <strong>Could not load the dashboard.</strong>
                    <p t-esc="state.error"/>
                </div>
                <button type="button" class="btn btn-primary" t-on-click="load">Retry</button>
            </div>

            <div t-if="state.loading" class="o_ecommerce_dashboard_loading">
                <span class="fa fa-circle-o-notch fa-spin"/> Loading metrics…
            </div>

            <t t-elif="state.data">
                <div t-if="!state.data.has_scope" class="o_ecommerce_dashboard_empty">
                    No active company context is available. Select a company to view the dashboard.
                </div>
                <t t-else="">
                    <div t-if="!state.data.has_stores" class="o_ecommerce_dashboard_notice">
                        No active Store matches the current filters. Odoo totals are still shown below.
                    </div>
                    <div class="o_ecommerce_dashboard_metric_grid">
                        <t t-foreach="state.data.metric_groups" t-as="group" t-key="group.key">
                            <section class="o_ecommerce_dashboard_metric_card" t-att-data-group="group.key">
                                <header class="o_ecommerce_dashboard_metric_header">
                                    <div>
                                        <h2 t-esc="group.label"/>
                                        <span t-esc="group.metric_label"/>
                                    </div>
                                    <span class="o_ecommerce_dashboard_snapshot" t-esc="periodLabel(group)"/>
                                </header>
                                <p class="o_ecommerce_dashboard_metric_help" t-esc="group.description"/>
                                <div class="o_ecommerce_dashboard_chart">
                                    <t t-foreach="group.bars" t-as="bar" t-key="bar.scope + (bar.store_id || '')">
                                        <button type="button"
                                                t-att-class="'o_ecommerce_dashboard_bar_row ' + (bar.scope === 'odoo' ? 'is_odoo' : 'is_store')"
                                                t-att-title="barTitle(bar, group)"
                                                t-att-data-metric="group.key"
                                                t-att-data-scope="bar.scope"
                                                t-att-data-store-id="bar.store_id || ''"
                                                t-on-click="onBarClick">
                                            <span class="o_ecommerce_dashboard_bar_label">
                                                <t t-esc="bar.label"/>
                                                <small t-if="bar.provider" t-esc="bar.provider"/>
                                            </span>
                                            <span class="o_ecommerce_dashboard_bar_track">
                                                <span class="o_ecommerce_dashboard_bar_fill"
                                                      t-att-style="barStyle(bar, bar_index, group)"/>
                                            </span>
                                            <strong t-esc="format(bar.value, group)"/>
                                        </button>
                                    </t>
                                    <p t-if="!group.has_data" class="o_ecommerce_dashboard_no_data">
                                        No data for this metric in the current scope.
                                    </p>
                                </div>
                            </section>
                        </t>
                    </div>
                </t>
            </t>
        </div>
    </t>
</templates>
