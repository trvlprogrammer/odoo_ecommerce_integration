<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ecommerce_product_mapping_list" model="ir.ui.view">
        <field name="name">ecommerce.product.mapping.list</field>
        <field name="model">ecommerce.product.mapping</field>
        <field name="arch" type="xml">
            <tree string="Product Mappings">
                <field name="store_id"/>
                <field name="external_id"/>
                <field name="external_sku"/>
                <field name="odoo_template_id"/>
                <field name="external_product_type"/>
                <field name="sync_state"/>
                <field name="last_synced_at"/>
            </tree>
        </field>
    </record>

    <record id="view_ecommerce_variant_mapping_list" model="ir.ui.view">
        <field name="name">ecommerce.variant.mapping.list</field>
        <field name="model">ecommerce.variant.mapping</field>
        <field name="arch" type="xml">
            <tree string="Variant Mappings">
                <field name="store_id"/>
                <field name="external_id"/>
                <field name="external_sku"/>
                <field name="odoo_product_id"/>
                <field name="last_pushed_quantity"/>
                <field name="sync_state"/>
            </tree>
        </field>
    </record>

    <record id="view_ecommerce_category_mapping_list" model="ir.ui.view">
        <field name="name">ecommerce.category.mapping.list</field>
        <field name="model">ecommerce.category.mapping</field>
        <field name="arch" type="xml">
            <tree string="Category Mappings">
                <field name="store_id"/>
                <field name="external_id"/>
                <field name="external_parent_id"/>
                <field name="odoo_category_id"/>
                <field name="sync_state"/>
            </tree>
        </field>
    </record>

    <record id="view_ecommerce_customer_mapping_list" model="ir.ui.view">
        <field name="name">ecommerce.customer.mapping.list</field>
        <field name="model">ecommerce.customer.mapping</field>
        <field name="arch" type="xml">
            <tree string="Customer Mappings">
                <field name="store_id"/>
                <field name="external_id"/>
                <field name="external_website_id"/>
                <field name="odoo_partner_id"/>
                <field name="sync_state"/>
            </tree>
        </field>
    </record>

    <record id="view_ecommerce_order_mapping_list" model="ir.ui.view">
        <field name="name">ecommerce.order.mapping.list</field>
        <field name="model">ecommerce.order.mapping</field>
        <field name="arch" type="xml">
            <tree string="Order Mappings">
                <field name="store_id"/>
                <field name="external_id"/>
                <field name="external_order_reference"/>
                <field name="odoo_sale_order_id"/>
                <field name="import_status"/>
                <field name="confirmation_status"/>
                <field name="financial_check"/>
                <field name="imported_at"/>
            </tree>
        </field>
    </record>

    <record id="view_ecommerce_order_mapping_form" model="ir.ui.view">
        <field name="name">ecommerce.order.mapping.form</field>
        <field name="model">ecommerce.order.mapping</field>
        <field name="arch" type="xml">
            <form string="Order Mapping">
                <sheet>
                    <group>
                        <group>
                            <field name="store_id"/>
                            <field name="external_id"/>
                            <field name="external_order_reference"/>
                            <field name="external_state"/>
                            <field name="external_status"/>
                            <field name="is_guest"/>
                        </group>
                        <group>
                            <field name="odoo_sale_order_id"/>
                            <field name="odoo_partner_id"/>
                            <field name="currency_id"/>
                            <field name="external_grand_total"/>
                            <field name="odoo_amount_total"/>
                            <field name="financial_check"/>
                        </group>
                    </group>
                    <group>
                        <field name="import_status"/>
                        <field name="confirmation_status"/>
                        <field name="last_error"/>
                        <field name="imported_at"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_ecommerce_product_mapping" model="ir.actions.act_window">
        <field name="name">Product Mappings</field>
        <field name="res_model">ecommerce.product.mapping</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_ecommerce_variant_mapping" model="ir.actions.act_window">
        <field name="name">Variant Mappings</field>
        <field name="res_model">ecommerce.variant.mapping</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_ecommerce_category_mapping" model="ir.actions.act_window">
        <field name="name">Category Mappings</field>
        <field name="res_model">ecommerce.category.mapping</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_ecommerce_customer_mapping" model="ir.actions.act_window">
        <field name="name">Customer Mappings</field>
        <field name="res_model">ecommerce.customer.mapping</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_ecommerce_order_mapping" model="ir.actions.act_window">
        <field name="name">Order Mappings</field>
        <field name="res_model">ecommerce.order.mapping</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
